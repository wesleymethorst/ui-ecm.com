# Auto-starts the offline emergency-info map server on boot, so the Pi is
# ready the moment it's powered on -- no SSH needed during the demo.
#
# Install:
#   sudo cp ecm-map.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ecm-map.service
#
# Check status / logs:
#   sudo systemctl status ecm-map
#   journalctl -u ecm-map -f

[Unit]
Description=ui-ecm.com offline map server
After=network.target

[Service]
Type=simple
User=root
# CHANGE THIS to wherever you copied the built dist/ folder on the Pi
WorkingDirectory=/home/pi/ui-ecm.com-dist
ExecStart=/usr/bin/python3 -m RangeHTTPServer 80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
